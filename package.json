{
  "name": "arena-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:min": "ng build --configuration production --optimization=true --source-map=false",
    "build:min:ssr": "npm run build:min && node dist/arena-app/server/server.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "serve:ssr:arena-app": "node dist/arena-app/server/server.mjs",
    "dev:stop": "node scripts/dev-stop.cjs",
    "dev:web": "ng serve --port 4200 --host 0.0.0.0",
    "dev:ssr:watch": "node scripts/dev-ssr-watch.cjs",
    "dev:all": "npm run dev:stop && concurrently -k -n BUILD,SSR,WEB -c yellow,magenta,cyan \"ng build --watch --configuration development\" \"npm run dev:ssr:watch\" \"npm run dev:web\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/platform-server": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/ssr": "^21.1.2",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "jspdf": "^4.2.1",
    "pg": "^8.20.0",
    "resend": "^6.9.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.0",
    "@playwright/test": "^1.60.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/pg": "^8.18.0",
    "concurrently": "^9.2.1",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.4"
  }
}
